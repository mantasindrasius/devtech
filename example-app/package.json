{
  "name": "@example/shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun scripts/start.ts --open",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:component": "bun test --preload ./tests/support/dom.ts tests/component",
    "test:e2e": "bun run build && playwright test",
    "test": "bun run typecheck && bun run test:unit && bun run test:integration && bun run test:component && bun run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.1",
    "happy-dom": "20.14.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@example/contracts": "workspace:*",
    "@example/catalog": "workspace:*",
    "@example/quotes": "workspace:*",
    "@example/orders": "workspace:*",
    "@example/sqlite-store": "workspace:*",
    "@example/cart": "workspace:*",
    "@example/checkout": "workspace:*",
    "@example/http-client": "workspace:*",
    "@example/http-server": "workspace:*",
    "@example/composition": "workspace:*"
  }
}
