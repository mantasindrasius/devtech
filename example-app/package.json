{
  "name": "@example/shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun scripts/start.ts --open",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun scripts/test-packages.ts test:unit",
    "test:integration": "bun scripts/test-packages.ts test:integration && bun test ./tests/architecture",
    "test:component": "bun run --cwd apps/web test:component",
    "test:e2e": "bun run --cwd packages/composition test:e2e",
    "test": "bun run typecheck && bun run test:unit && bun run test:integration && bun run test:component && bun run test:e2e"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@example/contracts": "workspace:*",
    "@example/catalog": "workspace:*",
    "@example/quotes": "workspace:*",
    "@example/orders": "workspace:*",
    "@example/sqlite-store": "workspace:*",
    "@example/cart": "workspace:*",
    "@example/checkout": "workspace:*",
    "@example/http-client": "workspace:*",
    "@example/http-server": "workspace:*",
    "@example/composition": "workspace:*"
  }
}
